# Local Email Triage Agent — environment configuration template
#
# Copy this file to `.env` and assign a valid value to every variable.
# `.env` is excluded from version control and must never be committed.


# Application services

# Base URL of the API container, as reachable from the UI container.
API_BASE_URL=http://email_triage_api_service:8000

# Model runtime

# Base URL of the Ollama inference server, as reachable from the API container.
OLLAMA_BASE_URL=http://ollama:11434

# Identifier assigned to the distilled classifier during `ollama create`.
OLLAMA_CLASSIFIER_MODEL=email-classifier

# Identifier of the reasoning model used for prioritization and reply drafting.
# Fixed pragmatically after a latency comparison on real hardware (see
# src/docs/adr/0009); no formal benchmark harness exists to reselect it.
OLLAMA_REASONING_MODEL=llama3.2:3b

# Request timeout applied to Ollama invocations, expressed in seconds.
OLLAMA_TIMEOUT_SECONDS=300

# Classifier provisioning

# HuggingFace repository providing the distilled classifier and its Modelfile.
HF_CLASSIFIER_REPO=distil-labs/distil-email-classifier

# Local directory receiving the downloaded classifier artifacts.
# Excluded from version control.
CLASSIFIER_LOCAL_DIR=./.models/distil-email-classifier

# Mailbox access

# IMAP server hostname and port used for message discovery and retrieval.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# SMTP server hostname and port used for reply transmission.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Fallback mailbox credentials, used only until the user signs in through the
# UI landing page (which stores working credentials in the database instead).
# Optional: leave both empty to require sign-in through the UI. For Gmail,
# IMAP_USERNAME is the full address and IMAP_PASSWORD must be an application
# password, never the regular account password.
IMAP_USERNAME=
IMAP_PASSWORD=

# Comma-separated list of mailbox folders subject to periodic scanning.
IMAP_FOLDERS=INBOX

# Destination folders for manually triggered archive and mark-spam actions.
IMAP_ARCHIVE_FOLDER=[Gmail]/All Mail
IMAP_SPAM_FOLDER=[Gmail]/Spam

# Interval between consecutive polling cycles, expressed in seconds.
POLL_INTERVAL_SECONDS=300

# Persistence

# Filesystem location of the application database within the container volume.
DATABASE_PATH=/app/data/email_triage.db

# Filesystem location of the LangGraph checkpoint store.
CHECKPOINT_PATH=/app/data/checkpoints.db

# Application behaviour

# Global read-only switch. When enabled, no write operation is performed on the
# mailbox regardless of the policy configuration. Required during phase 1.
DRY_RUN=true

# Application logging verbosity: INFO or DEBUG.
LOG_LEVEL=INFO
